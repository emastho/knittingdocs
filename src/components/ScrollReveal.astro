---
// ScrollReveal.astro
// Marks the pieces of every [data-reveal] section and fades them up, in order,
// the first time that section reaches the viewport. Drop it once per page.
//
// No-JS and reduced-motion both end up with everything visible: the hiding
// class is only ever added by the script below.
---

<script is:inline>
  (() => {
    const sections = document.querySelectorAll("[data-reveal]");
    if (!sections.length) return;

    // Containers whose tiles should rise one by one instead of as one block.
    const GROUPS = ".kh-grid, .kh-fit-grid, .kh-bench-kpis";

    const items = (section) => {
      const list = [];
      for (const child of section.children) {
        if (child.hidden) continue;
        if (child.matches(GROUPS)) list.push(...child.children);
        else list.push(child);
      }
      return list;
    };

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    for (const section of sections) {
      if (reduced.matches) {
        section.classList.add("is-in");
        continue;
      }
      items(section).forEach((el, i) => {
        el.classList.add("kh-rise");
        el.style.setProperty("--kh-i", String(i));
      });
    }

    if (reduced.matches) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
  })();
</script>

<style is:global>
  [data-reveal] .kh-rise {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 620ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--kh-i, 0) * 70ms);
  }

  [data-reveal].is-in .kh-rise {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] .kh-rise {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
