---
type ThroughputRow = {
  route: string;
  before: number;
  after: number;
  gainPercent: number;
};

const rows: ThroughputRow[] = [
  { route: "/ping", before: 2815, after: 8486, gainPercent: 201 },
  { route: "/ssr", before: 2815, after: 4816, gainPercent: 71 },
  { route: "/jwt", before: 2578, after: 4712, gainPercent: 83 },
];

const pingP99BeforeMs = 16.93;
const pingP99AfterMs = 2.31;
const pingP99LatencyReductionPercent = 86;
// One-worker runs measured 1.10 and 1.06 cores against the inline server's
// 1.08, so the shapes are at CPU parity. Show the parity and keep the raw
// measurements in the metadata as well.
const serverCoresHostOnly = 1.08;
const serverCoresOneWorker = 1.1;
const serverCoresOneWorkerRepeat = 1.06;
const maxAfter = Math.max(...rows.map((row) => row.after));
const cpuScaleMin = 1;
const cpuScaleMax = 1.15;

const benchmarkMetadata = {
  benchmark: "hono-ssr-jwt-zod",
  metricUnits: {
    throughput: "requests_per_second",
    gain: "percent",
    tailLatencyReduction: "percent_lower",
  },
  rows: rows.map((row) => ({
    route: row.route,
    beforeRequestsPerSecond: row.before,
    afterRequestsPerSecond: row.after,
    gainPercent: row.gainPercent,
  })),
  tailLatency: {
    percentile: "p99",
    beforeMs: pingP99BeforeMs,
    afterMs: pingP99AfterMs,
    reductionPercent: pingP99LatencyReductionPercent,
  },
  serverCpu: {
    unit: "cores",
    hostOnly: serverCoresHostOnly,
    oneWorker: serverCoresOneWorker,
    oneWorkerRepeat: serverCoresOneWorkerRepeat,
    reading: "parity: the repeat run brackets the host-only figure from below",
  },
};
const benchmarkMetadataJson = JSON.stringify(benchmarkMetadata);

function width(value: number) {
  return `${((value / maxAfter) * 100).toFixed(2)}%`;
}

function cpuPosition(value: number) {
  return `${(((value - cpuScaleMin) / (cpuScaleMax - cpuScaleMin)) * 100).toFixed(2)}%`;
}
---

<section class="impact-panel" aria-label="Hono benchmark impact">
  <header class="impact-header">
    <p class="impact-kicker">Hono + SSR + JWT + Zod benchmark</p>
  </header>

  <p class="impact-group-label">
    Fixed mixed load — 6,000 rps
    <span>both configurations completed the offered rate</span>
  </p>

  <div class="impact-summary" role="group" aria-label="Key benchmark numbers">
    <section
      class="impact-stat impact-stat-latency"
      data-tail-latency-percentile="p99"
      data-tail-latency-reduction-percent={String(pingP99LatencyReductionPercent)}
      aria-label={`/ping p99 latency: ${pingP99BeforeMs} milliseconds with Hono only, ${pingP99AfterMs} milliseconds with one worker, ${pingP99LatencyReductionPercent} percent lower`}
    >
      <p class="impact-stat-label"><code>/ping</code> p99 latency</p>
      <div class="impact-stat-numbers">
        <div class="impact-stat-number">
          <strong>{pingP99BeforeMs.toFixed(2)}</strong>
          <span>ms</span>
          <small>Hono only</small>
        </div>
        <span class="impact-arrow" aria-hidden="true">→</span>
        <div class="impact-stat-number impact-stat-number-after">
          <strong>{pingP99AfterMs.toFixed(2)}</strong>
          <span>ms</span>
          <small>one worker</small>
        </div>
      </div>
      <p class="impact-delta"><strong>−{pingP99LatencyReductionPercent}%</strong> tail latency</p>
    </section>

    <section
      class="impact-stat impact-stat-cpu"
      data-server-cores-host-only={serverCoresHostOnly.toFixed(2)}
      data-server-cores-one-worker={serverCoresOneWorker.toFixed(2)}
      data-server-cores-one-worker-repeat={serverCoresOneWorkerRepeat.toFixed(2)}
      aria-label={`Server CPU: ${serverCoresHostOnly.toFixed(2)} cores with Hono only; ${serverCoresOneWorker.toFixed(2)} and ${serverCoresOneWorkerRepeat.toFixed(2)} cores in two one-worker runs`}
    >
      <p class="impact-stat-label">server-process CPU</p>
      <div class="impact-stat-numbers impact-cpu-numbers">
        <div class="impact-stat-number">
          <strong>{serverCoresHostOnly.toFixed(2)}</strong>
          <span>cores</span>
          <small>Hono only</small>
        </div>
        <span class="impact-arrow" aria-hidden="true">≈</span>
        <div class="impact-stat-number impact-stat-number-after">
          <strong>{serverCoresOneWorker.toFixed(2)} / {serverCoresOneWorkerRepeat.toFixed(2)}</strong>
          <span>cores</span>
          <small>one-worker runs</small>
        </div>
      </div>
      <div class="impact-cpu-scale" aria-hidden="true">
        <div class="impact-cpu-axis">
          <span style={`left: ${cpuPosition(1)};`}>1.00</span>
          <span style={`left: ${cpuPosition(1.05)};`}>1.05</span>
          <span style={`left: ${cpuPosition(1.1)};`}>1.10</span>
          <span style={`left: ${cpuPosition(1.15)};`}>1.15</span>
        </div>
        <div class="impact-cpu-track">
          <div
            class="impact-cpu-range"
            style={`left: ${cpuPosition(serverCoresOneWorkerRepeat)}; width: ${(((serverCoresOneWorker - serverCoresOneWorkerRepeat) / (cpuScaleMax - cpuScaleMin)) * 100).toFixed(2)}%;`}
          />
          <span class="impact-cpu-dot impact-cpu-dot-host" style={`left: ${cpuPosition(serverCoresHostOnly)};`} />
        </div>
      </div>
      <p class="impact-cpu-reading">same load · the repeat run brackets the host-only result</p>
    </section>
  </div>

  <p class="impact-group-label">
    Pushed to saturation
    <span>requests per second, higher is better</span>
  </p>

  <div class="impact-legend" aria-label="Throughput chart legend">
    <span><i class="impact-legend-swatch impact-legend-before" aria-hidden="true" />Hono only</span>
    <span><i class="impact-legend-swatch impact-legend-after" aria-hidden="true" />one worker</span>
  </div>

  <ul class="impact-list">
    {rows.map((row) => (
      <li
        class="impact-row"
        data-route={row.route}
        data-before-rps={String(row.before)}
        data-after-rps={String(row.after)}
        data-gain-percent={String(row.gainPercent)}
      >
        <div class="impact-row-head">
          <code class="impact-route">{row.route}</code>
          <span class="impact-chip">+{row.gainPercent}%</span>
        </div>

        <div
          class="impact-bars"
          role="img"
          aria-label={`${row.route}: ${row.before.toLocaleString()} requests per second with Hono only, ${row.after.toLocaleString()} with one worker, ${row.gainPercent} percent higher`}
        >
          <div class="impact-bar-line">
            <span class="impact-series impact-series-before">Hono only</span>
            <div class="impact-bar-track" aria-hidden="true">
              <div class="impact-bar before" style={`width: ${width(row.before)};`} />
            </div>
            <strong>{row.before.toLocaleString()}</strong>
          </div>
          <div class="impact-bar-line">
            <span class="impact-series impact-series-after">one worker</span>
            <div class="impact-bar-track" aria-hidden="true">
              <div class="impact-bar after" style={`width: ${width(row.after)};`} />
            </div>
            <strong>{row.after.toLocaleString()}</strong>
          </div>
        </div>
      </li>
    ))}
  </ul>

  <div class="impact-axis" aria-hidden="true">
    <span>0</span>
    <span>4k</span>
    <span>8.5k rps</span>
  </div>

  <script
    type="application/json"
    data-benchmark-metadata="impact-bars"
    set:html={benchmarkMetadataJson}
  ></script>
</section>

<style>
  .impact-panel {
    --impact-surface: var(--sl-color-bg);
    --impact-border: color-mix(in srgb, var(--sl-color-text) 18%, transparent);
    --impact-muted: color-mix(in srgb, var(--sl-color-text) 62%, transparent);
    --impact-track: color-mix(in srgb, var(--sl-color-text) 10%, transparent);
    --impact-before: #7c8796;
    --impact-after: var(--sl-color-purple);
    display: grid;
    gap: 0.85rem;
    padding: 0.9rem;
    border: 1px solid var(--impact-border);
    border-radius: 0.25rem;
    background: var(--impact-surface);
  }

  .impact-header {
    display: grid;
    gap: 0.2rem;
  }

  .impact-kicker {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--impact-muted);
  }

  .impact-subtitle {
    margin: 0;
    font-size: 0.85rem;
    color: var(--impact-muted);
  }

  .impact-group-label {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--sl-color-text) 78%, transparent);
  }

  .impact-group-label span {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--impact-muted);
  }

  .impact-summary {
    display: grid;
    border-top: 1px solid var(--impact-border);
    border-bottom: 1px solid var(--impact-border);
  }

  .impact-stat {
    min-width: 0;
    padding: 0.8rem 0;
  }

  .impact-stat + .impact-stat {
    border-top: 1px solid var(--impact-border);
  }

  .impact-stat-label {
    margin: 0;
    color: var(--impact-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .impact-stat-numbers {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.55rem;
  }

  .impact-stat-number {
    min-width: 0;
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    column-gap: 0.24rem;
  }

  .impact-stat-number strong {
    color: color-mix(in srgb, var(--sl-color-text) 92%, transparent);
    font-size: clamp(1.15rem, 3vw, 1.55rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .impact-stat-number > span {
    color: var(--impact-muted);
    font-size: 0.7rem;
  }

  .impact-stat-number small {
    grid-column: 1 / -1;
    margin-top: 0.28rem;
    color: var(--impact-muted);
    font-size: 0.68rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .impact-stat-number-after strong,
  .impact-stat-number-after > span {
    color: color-mix(in srgb, var(--sl-color-purple) 72%, var(--sl-color-text) 28%);
  }

  .impact-arrow {
    flex: 0 0 auto;
    color: var(--impact-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .impact-delta {
    margin: 0.7rem 0 0;
    color: var(--impact-muted);
    font-size: 0.75rem;
  }

  .impact-delta strong {
    color: color-mix(in srgb, #2563eb 68%, var(--sl-color-purple) 32%);
    font-variant-numeric: tabular-nums;
  }

  .impact-cpu-numbers {
    gap: 0.35rem;
  }

  .impact-cpu-numbers .impact-stat-number-after {
    min-width: 0;
  }

  .impact-cpu-numbers .impact-stat-number-after strong {
    font-size: clamp(0.95rem, 2.8vw, 1.35rem);
    letter-spacing: -0.03em;
  }

  .impact-cpu-scale {
    margin-top: 0.8rem;
    padding-top: 1rem;
  }

  .impact-cpu-axis {
    position: relative;
    height: 0.8rem;
    margin-inline: 0.2rem;
  }

  .impact-cpu-axis span {
    position: absolute;
    transform: translateX(-50%);
    color: var(--impact-muted);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
  }

  .impact-cpu-axis span:first-child {
    transform: none;
  }

  .impact-cpu-axis span:last-child {
    transform: translateX(-100%);
  }

  .impact-cpu-track {
    position: relative;
    height: 0.42rem;
    border-radius: 0;
    background: var(--impact-track);
  }

  .impact-cpu-track::before,
  .impact-cpu-track::after {
    content: "";
    position: absolute;
    top: -0.18rem;
    bottom: -0.18rem;
    width: 1px;
    background: color-mix(in srgb, var(--sl-color-text) 16%, transparent);
  }

  .impact-cpu-track::before {
    left: 33.33%;
  }

  .impact-cpu-track::after {
    left: 66.67%;
  }

  .impact-cpu-range {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 0.35rem;
    border-radius: 0;
    background: var(--impact-after);
  }

  .impact-cpu-dot {
    position: absolute;
    top: 50%;
    width: 0.72rem;
    height: 0.72rem;
    border: 2px solid var(--impact-surface);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .impact-cpu-dot-host {
    background: var(--impact-before);
  }

  .impact-cpu-reading {
    margin: 0.45rem 0 0;
    color: var(--impact-muted);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .impact-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
    margin-top: -0.25rem;
    color: var(--impact-muted);
    font-size: 0.7rem;
  }

  .impact-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .impact-legend-swatch {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 0;
  }

  .impact-legend-before {
    background: var(--impact-before);
  }

  .impact-legend-after {
    background: var(--impact-after);
  }

  .impact-list {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .impact-row {
    display: grid;
    gap: 0.35rem;
  }

  .impact-row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .impact-route {
    font-weight: 700;
    color: color-mix(in srgb, var(--sl-color-text) 88%, transparent);
  }

  .impact-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-left: 0.55rem;
    border-left: 2px solid var(--impact-after);
    border-radius: 0;
    background: transparent;
    color: color-mix(in srgb, var(--sl-color-purple) 76%, var(--sl-color-text) 24%);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .impact-bars {
    display: grid;
    gap: 0.42rem;
  }

  .impact-bar-line {
    display: grid;
    grid-template-columns: 4.8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.45rem;
  }

  .impact-series {
    color: var(--impact-muted);
    font-size: 0.68rem;
    line-height: 1.1;
    white-space: nowrap;
  }

  .impact-series-after {
    color: color-mix(in srgb, var(--sl-color-purple) 72%, var(--sl-color-text) 28%);
  }

  .impact-bar-track {
    width: 100%;
    height: 0.52rem;
    border-radius: 0;
    overflow: clip;
    background: var(--impact-track);
  }

  .impact-bar {
    height: 100%;
    border-radius: 0;
  }

  .impact-bar.before {
    background: var(--impact-before);
    opacity: 0.84;
  }

  .impact-bar.after {
    background: var(--impact-after);
  }

  .impact-bar-line strong {
    color: color-mix(in srgb, var(--sl-color-text) 84%, transparent);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .impact-axis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-left: 5.25rem;
    color: var(--impact-muted);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
  }

  .impact-axis span:nth-child(2) {
    text-align: center;
  }

  .impact-axis span:last-child {
    text-align: right;
  }

  @media (max-width: 800px) {
    .impact-panel {
      padding: 0.75rem;
    }

    .impact-bar-line {
      grid-template-columns: 4.8rem minmax(0, 1fr) auto;
    }

    .impact-axis {
      margin-left: 5.25rem;
    }
  }

  :global(:root[data-theme="dark"]) .impact-panel {
    --impact-surface: var(--sl-color-bg);
    --impact-border: color-mix(in srgb, var(--sl-color-white) 18%, transparent);
    --impact-muted: color-mix(in srgb, var(--sl-color-white) 68%, transparent);
    --impact-track: color-mix(in srgb, var(--sl-color-white) 14%, transparent);
    --impact-before: #64748b;
    --impact-after: #a78bfa;
  }

  :global(:root[data-theme="dark"]) .impact-chip {
    color: #e9ddff;
    border-color: #a78bfa;
    background: transparent;
  }

  :global(:root[data-theme="dark"]) .impact-stat-number-after strong,
  :global(:root[data-theme="dark"]) .impact-stat-number-after > span,
  :global(:root[data-theme="dark"]) .impact-series-after {
    color: #c4b5fd;
  }

  :global(:root[data-theme="dark"]) .impact-delta strong {
    color: #93c5fd;
  }

  :global(:root[data-theme="dark"]) .impact-group-label {
    color: color-mix(in srgb, var(--sl-color-white) 82%, transparent);
  }

  :global(:root[data-theme="dark"]) .impact-stat-number:not(.impact-stat-number-after) strong,
  :global(:root[data-theme="dark"]) .impact-bar-line strong {
    color: color-mix(in srgb, var(--sl-color-white) 86%, transparent);
  }
</style>
