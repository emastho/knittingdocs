<figure class="queue-impact">
  <div class="queue-layout" role="img" aria-label="Before: ping, rendering, and signing share the main thread. After: ping stays on the main thread; rendering and signing run in one worker. Schematic, not a timeline.">
    <div class="queue-case">
      <p class="queue-label">Before</p>
      <div class="queue-lane">
        <span>Main thread</span>
        <div class="queue-tasks"><span>Render</span><span>Sign</span><code>/ping</code></div>
      </div>
    </div>
    <div class="queue-case">
      <p class="queue-label">With one worker</p>
      <div class="queue-lane">
        <span>Main thread</span>
        <div class="queue-tasks"><code>/ping</code></div>
      </div>
      <div class="queue-lane">
        <span>Worker</span>
        <div class="queue-tasks"><span>Render</span><span>Sign</span></div>
      </div>
    </div>
  </div>

  <div class="queue-result">
    <p><code>/ping</code> response time <span>p99 · lower is better</span></p>
    <div class="queue-numbers">
      <div><strong>16.93 <small>ms</small></strong><span>Before</span></div>
      <span class="queue-arrow" aria-hidden="true">→</span>
      <div><strong class="queue-after">2.31 <small>ms</small></strong><span>With one worker</span></div>
    </div>
  </div>

  <figcaption>
    6,000 requests/sec in both runs.<br />
    CPU per request: 180 µs before · 183 µs with one worker.
  </figcaption>
</figure>

