---
import DefaultSocialIcons from "@astrojs/starlight/components/SocialIcons.astro";

const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
const isHome = Astro.url.pathname === normalizedBase;
const docsHref = `${normalizedBase}start/installation/`;
---

<DefaultSocialIcons />
{
  isHome && (
    <a class="docs-shortcut" href={docsHref} aria-label="Open the Knitting documentation">
      Docs
      <span aria-hidden="true">→</span>
    </a>
  )
}

<style is:global>
  /* Starlight hides the header's right group below its nav breakpoint, which
     takes the Docs shortcut with it. A splash page has no sidebar and no menu
     button, so on a phone that leaves the home page with no route into the
     docs tree at all. Bring back the shortcut alone, unlayered so it outranks
     the `sl-hidden` utility. */
  @media (max-width: 49.9375rem) {
    html:has([data-knit-home-marker]) .page > header .right-group {
      display: flex;
    }

    html:has([data-knit-home-marker]) .page > header .right-group > *:not(.social-icons),
    html:has([data-knit-home-marker]) .page > header .social-icons > *:not(.docs-shortcut) {
      display: none;
    }

    /* The group's trailing divider only makes sense beside the icons it split. */
    html:has([data-knit-home-marker]) .page > header .social-icons::after {
      content: none;
    }
  }
</style>

<style>
  @layer starlight.core {
    .docs-shortcut {
      min-height: 2rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.7rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 42%, transparent);
      border-radius: 999px;
      color: var(--sl-color-text-accent);
      font-size: 0.78rem;
      font-weight: 750;
      line-height: 1;
      text-decoration: none;
      transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }

    .docs-shortcut:hover {
      border-color: var(--sl-color-text-accent);
      background: color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
      transform: translateY(-1px);
    }

    .docs-shortcut:focus-visible {
      outline: 3px solid var(--sl-color-accent);
      outline-offset: 3px;
    }
  }
</style>
