---
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';
import { runtimeReport } from '../../lib/bench-history';
import type { RuntimeId } from '../../lib/bench';
interface Props { runtime: RuntimeId }
const { runtime } = Astro.props;
const suites = [
  ['Empty calls', 'latency'],
  ['Payload comparison', 'types'],
  ['CPU-heavy work', 'withload'],
  ['IPC', 'ipc'],
  ['Payload growth', 'call-growth-batch'],
  ['All types', 'types_knitting'],
];
---
<Tabs>
  {suites.map(([label, suite]) => (
    <TabItem label={label}>
      <Code code={runtimeReport(runtime, suite)} lang="md" title={`${runtime}_${suite}.md`} />
    </TabItem>
  ))}
</Tabs>
